generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Un run dell'ingestion: raccoglie notizie, ne estrae segnali (Signal)
// e registra i prezzi reali (PriceSnapshot) degli asset coinvolti.
model Digest {
  id             String   @id @default(cuid())
  creatoIl       DateTime @default(now())
  periodoCoperto String

  newsItems      NewsItem[]
  signals        Signal[]
  priceSnapshots PriceSnapshot[]
}

// Un articolo grezzo raccolto in un digest, prima di qualunque analisi.
model NewsItem {
  id                String   @id @default(cuid())
  digestId          String
  digest            Digest   @relation(fields: [digestId], references: [id])
  fonte             String
  url               String
  titolo            String
  estratto          String
  dataPubblicazione DateTime
  // "crypto" | "tradizionale" — nota gia' nel feed RSS di origine
  // (RssFeedConfig.categoria in ingestion/sources/news-rss.ts), qui
  // solo persistita cosi' un Signal puo' risalire a quanta della sua
  // attenzione viene dal mondo crypto vs tradizionale.
  categoria         String

  signals Signal[]

  @@index([digestId])
}

// Un'entità/tema estratto dalle notizie di un digest (azienda, asset,
// settore, paese, tema), con quanto se ne parla e con che tono.
model Signal {
  id                                    String @id @default(cuid())
  digestId                              String
  digest                                Digest @relation(fields: [digestId], references: [id])
  tipo                                  String // azienda | asset | settore | paese | tema
  nome                                  String
  conteggioMenzioni                     Int
  // conteggioMenzioni / numero totale di articoli nel digest — rende
  // confrontabili tra loro digest con un numero diverso di articoli
  // (le finestre tra un digest e l'altro non sono uniformi, vedi
  // "Decisione sulla frequenza" in docs/piano-architettura.md). Usata
  // al posto del conteggio grezzo per decidere se un segnale già visto
  // è trending e per calcolare la variazione sotto.
  quotaAttenzione                       Float
  sentimentMedio                        Float // -1..1
  // ora calcolata su quotaAttenzione, non sul conteggio grezzo — vedi
  // sopra.
  variazioneRispettoAlDigestPrecedente  Float?
  // true se nome+tipo non compare in NESSUN digest precedente (non solo
  // l'ultimo) — distingue una prima comparsa vera da un segnale che
  // torna dopo un'assenza. Calcolato una volta alla creazione, non
  // ricavato a posteriori: riflette cosa si sapeva nel momento del
  // digest, non lo stato attuale dello storico.
  primaComparsa                         Boolean

  explanation    Explanation?
  priceSnapshots PriceSnapshot[]
  // articoli grezzi da cui e' stato estratto questo segnale — traccia
  // la provenienza (dashboard) e da' contesto reale alla spiegazione
  // didattica (ingestion/analysis/explain-trending.ts) invece di farla
  // scrivere all'LLM senza fonti sotto mano.
  newsItems      NewsItem[]

  @@index([digestId])
}

// Spiegazione didattica generata solo per i Signal che superano la
// soglia di "trending" — non uno per ogni Signal.
model Explanation {
  id           String @id @default(cuid())
  signalId     String @unique
  signal       Signal @relation(fields: [signalId], references: [id])
  testo        String
  modelloUsato String
}

// Prezzo dell'asset legato a un Signal nel momento in cui gira il
// digest, raccolto in parallelo per poter validare più avanti quanto i
// Signal anticipano davvero un movimento di mercato reale. Il campo si
// chiama prezzoChiusura ma NON è sempre una chiusura di mercato in
// senso stretto: con 3 digest al giorno (08:00/12:00/22:00, vedi
// docs/piano-architettura.md) solo quello delle 22:00 coincide con la
// chiusura NYSE/Nasdaq, gli altri due sono prezzi intraday.
model PriceSnapshot {
  id             String   @id @default(cuid())
  digestId       String
  digest         Digest   @relation(fields: [digestId], references: [id])
  signalId       String?
  signal         Signal?  @relation(fields: [signalId], references: [id])
  ticker         String
  tipo           String // crypto | azione | indice
  prezzoChiusura Float
  // Volume scambiato nelle 24h (crypto, CoinGecko usd_24h_vol) o
  // volume di sessione (azioni/indici, Yahoo Finance
  // regularMarketVolume) — stessa chiamata già fatta per il prezzo,
  // nessuna fonte dati nuova. Opzionale: non tutte le risposte lo
  // includono sempre.
  volume         Float?
  // Capitalizzazione di mercato nello stesso momento del prezzo (crypto:
  // CoinGecko usd_market_cap; azioni: Yahoo Finance marketCap — entrambi
  // verificati dal vivo il 2026-09-16). Assente per gli indici (^GSPC ecc.,
  // un indice non ha una capitalizzazione propria) — usata per il rapporto
  // attenzione/capitalizzazione, non solo informativa come il volume.
  marketCap      Float?
  data           DateTime

  @@index([digestId])
  @@index([signalId])
}
